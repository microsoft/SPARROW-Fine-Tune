# Copy to .env.service and pass with --env-file. Never commit the real file.
POSTGRES_PASSWORD=change-me

# Comma-separated bearer tokens for machine clients (optional). With no tokens and no
# users (`sparrow-finetune create-user`), the API is open: keep it on loopback then.
SPARROW_FT_API_TOKENS=

# Embedder spec for dinov3_linear (see docs). It is built when a job runs: if empty,
# the pipeline is still listed but its jobs fail with a configuration error.
SPARROW_FT_EMBEDDER=

# Local weights directory inside the worker containers (optional): timm/<model>/ for
# conventional_classifier without network, and engine stock model packages
# (<name>/manifest.toml) for the stock_model comparison. Mount the host directory there in a
# compose override, e.g. `volumes: ["/srv/weights:/weights:ro"]` on worker-cpu and worker-gpu.
SPARROW_FT_WEIGHTS_DIR=

# Sparrow Studio connector (optional): base URL and the service token Studio expects
# in SPARROW_FINETUNE_SERVICE_TOKEN.
SPARROW_FT_STUDIO_URL=
SPARROW_FT_STUDIO_TOKEN=

# Sign-in (default 1 = off): the web app is opened from Sparrow Studio's "Model fine-tune"
# page and anyone who can reach this port can use it. Keep SPARROW_FT_BIND on loopback or a
# private network. Set 0 to require the accounts created with `sparrow-finetune create-user`.
SPARROW_FT_AUTH_DISABLED=1

# Browser sessions: set COOKIE_SECURE=1 behind HTTPS.
SPARROW_FT_COOKIE_SECURE=0
SPARROW_FT_SESSION_HOURS=12

# Scheduling. Pipelines listed here only run on a worker with the gpu resource (worker-gpu,
# compose profile "gpu"); without one their jobs wait with "No GPU worker online". Leave empty
# when there is no GPU worker. MAX_RUNNING_PER_USER caps one user's running jobs (0 = no cap);
# a freed worker always takes the oldest job of the user with the fewest running jobs.
SPARROW_FT_GPU_PIPELINES=
# SPARROW_FT_GPU_PIPELINES=yolo_detector,conventional_classifier
SPARROW_FT_MAX_RUNNING_PER_USER=0

# Published address of the API.
SPARROW_FT_BIND=127.0.0.1
SPARROW_FT_PORT=8000
